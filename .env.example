# FinanceOS credentials only.
# Copy this file to `.env` and fill in local secret values.
# Non-secret settings belong in config.yml, copied from config.example.yml.
# NEVER commit `.env`.

# PostgreSQL credentials
DATABASE_USERNAME="finance_os"
DATABASE_PASSWORD=""

# Application/authentication signing secret; generate with: openssl rand -base64 32
APP_SECRET=""

# Key for encrypting sensitive fields at rest (account identifiers).
# 32 random bytes, URL-safe base64; generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing this key makes the encrypted fields unrecoverable.
ENCRYPTION_KEY=""

# No third-party/paid API credentials are required for the MVP by design.
# Do not add one here without updating CLAUDE.md's security requirements
# and getting explicit sign-off — see "Zero-API-budget" in README.md.
