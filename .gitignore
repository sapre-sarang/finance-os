# === FinanceOS .gitignore ===
# Stack: React / TypeScript / Python / FastAPI / PostgreSQL / Docker
# Goal: never let secrets, credentials, env files, or local financial data
# reach version control.

# --- Secrets & environment ---
.env
.env.*
!.env.example
/config.yml
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
**/*secret*
**/*credential*
!**/*secret*.example
!**/*credential*.example

# --- Local financial / personal data (never commit real data) ---
*.sqlite
*.sqlite3
*.db
/data/
/exports/
/imports/
/statements/
/uploads/
*.ofx
*.qfx
*.qif

# --- Node ---
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- React / deployment ---
out/
build/
dist/
.turbo/
.vercel/

# --- TypeScript ---
*.tsbuildinfo
vite.config.*.timestamp-*

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Database migrations ---
packages/db/alembic/versions/dev/

# --- Testing ---
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
playwright-report/
test-results/

# --- Docker ---
*.pid

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Misc local overrides ---
*.local
.cache/
